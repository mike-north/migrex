{
  "name": "@migrex/cli",
  "description": "CLI tool for migrex",
  "version": "0.2.0-alpha.2",
  "bin": {
    "migrex": "./dist/index.js"
  },
  "dependencies": {
    "@migrex/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.48.0",
    "@types/node": "^20.19.30",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run generate:api-report",
    "build:types": "tsc -p tsconfig.build.json",
    "check:api-report": "api-extractor run",
    "clean": "rm -rf dist temp/*.d.ts temp/*.api.json",
    "generate:api-report": "api-extractor run --local",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/cli.d.ts"
}

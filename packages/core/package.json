{
  "name": "@migrex/core",
  "description": "Core library for versioned data contracts with bidirectional migrations",
  "version": "0.2.0-alpha.0",
  "dependencies": {
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.48.0",
    "fast-check": "^4.5.3",
    "tsd": "^0.31.0",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run generate:api-report",
    "build:types": "tsc -p tsconfig.build.json",
    "check:api-report": "api-extractor run",
    "clean": "rm -rf dist temp/*.d.ts temp/*.api.json",
    "generate:api-report": "api-extractor run --local",
    "test": "vitest run",
    "test:types": "tsd",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/core.d.ts"
}

{
  "name": "@migrex/ts-plugin",
  "description": "TypeScript Language Service Plugin for migrex",
  "version": "0.2.0-alpha.1",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.48.0",
    "@types/node": "^20.19.30",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "peerDependencies": {
    "@migrex/core": "workspace:*",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run generate:api-report",
    "build:types": "tsc -p tsconfig.build.json",
    "check:api-report": "api-extractor run",
    "clean": "rm -rf dist temp/*.d.ts temp/*.api.json",
    "generate:api-report": "api-extractor run --local",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "types": "./dist/ts-plugin.d.ts"
}

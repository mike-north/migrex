{
  "name": "@migrex/json-schema",
  "description": "JSON Schema plugin for migrex",
  "version": "1.0.0-alpha.0",
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.48.0",
    "@migrex/core": "workspace:*",
    "@types/json-schema": "^7.0.15",
    "tsd": "^0.31.0",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/json-schema.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/json-schema.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@migrex/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run generate:api-report",
    "build:types": "tsc -p tsconfig.build.json",
    "check:api-report": "api-extractor run",
    "clean": "rm -rf dist temp/*.d.ts temp/*.api.json",
    "generate:api-report": "api-extractor run --local",
    "test": "vitest run",
    "test:types": "tsd",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/json-schema.d.ts"
}

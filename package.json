{
  "name": "migrex-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Migrex Workspace",
  "scripts": {
    "build": "pnpm -r build",
    "build:types": "pnpm -r build:types",
    "clean": "pnpm -r clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:types": "pnpm -r test:types",
    "api:check": "pnpm -r api:check",
    "api:update": "pnpm -r api:update",
    "docs": "api-documenter markdown -i packages/*/temp -o docs",
    "knip": "knip",
    "syncpack:check": "syncpack lint",
    "syncpack:fix": "syncpack fix-mismatches",
    "typecheck": "tsc -b",
    "validate": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm api:check && pnpm knip",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish"
  },
  "keywords": [],
  "author": "Mike North <michael.l.north@gmail.com>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.0.0",
    "@microsoft/api-documenter": "^7.26.0",
    "@microsoft/api-extractor": "^7.48.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "knip": "^5.0.0",
    "prettier": "^3.0.0",
    "syncpack": "^13.0.0",
    "tsd": "^0.31.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}

{
  "name": "@migrex/ts-plugin",
  "description": "TypeScript Language Service Plugin for migrex",
  "version": "0.2.0-alpha.0",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.48.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "build": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist temp/*.d.ts temp/*.api.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "types": "./dist/ts-plugin.d.ts"
}

{
  "name": "@migrex/eslint-plugin",
  "description": "ESLint plugin for migrex",
  "version": "0.2.0-alpha.0",
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.48.0",
    "@migrex/core": "workspace:*",
    "@typescript-eslint/rule-tester": "^8.0.0",
    "eslint": "^9.0.0",
    "tsd": "^0.31.0",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/eslint-plugin.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/eslint-plugin.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@migrex/core": "workspace:*",
    "eslint": "^9.0.0"
  },
  "scripts": {
    "build": "tsup && pnpm run build:types && pnpm run generate:api-report",
    "build:types": "tsc -p tsconfig.build.json",
    "check:api-report": "api-extractor run",
    "clean": "rm -rf dist temp/*.d.ts temp/*.api.json",
    "generate:api-report": "api-extractor run --local",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/eslint-plugin.d.ts",
  "publishConfig": {
    "access": "public"
  }
}

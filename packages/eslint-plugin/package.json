{
  "name": "@migrex/eslint-plugin",
  "description": "ESLint plugin for migrex",
  "version": "0.1.0",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.48.0",
    "eslint": "^9.0.0",
    "tsd": "^0.31.0",
    "tsup": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/eslint-plugin.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/eslint-plugin.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "scripts": {
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "build": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist temp/*.d.ts temp/*.api.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/eslint-plugin.d.ts"
}
